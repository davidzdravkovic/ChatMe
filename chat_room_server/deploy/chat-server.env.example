# Linux real JWT build (same code paths as Windows with CHAT_ENABLE_JWT):
#   sudo apt install -y libssl-dev cmake g++ libpq-dev libboost-all-dev
#   optional: sudo apt install -y libjwt-cpp-dev   # skips CMake downloading jwt-cpp
#   cd build && cmake .. -DCMAKE_BUILD_TYPE=Release -DCHAT_ENABLE_JWT=ON && cmake --build . -j"$(nproc)"
#
# Copy to Config/chat_server.env on the server (same directory as Jwt.json / Network.json).
# systemd: EnvironmentFile=/root/chat_room_server/Config/chat_server.env
#
# Required for chat_server startup (DeserializeConfig::loadJwt already reads JWT_SECRET).
# With default CMake (CHAT_ENABLE_JWT=OFF), a non-empty JWT_SECRET is enough for the
# server to issue dev-style `dev:userId:userName` tokens on login/create.
#
JWT_SECRET=replace-with-long-random-string-openssl-rand-hex-32

# Optional: force dev tokens even with no secret (not recommended if Jwt.json requires secret).
# CHAT_INSECURE_DEV_AUTH=1
